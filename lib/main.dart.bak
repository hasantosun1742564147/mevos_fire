          (
            'Maks. Kapsama / Sprinkler',
            s.maxKapsamaEfektif == s.sinif.maxKapsama
                ? '${s.sinif.maxKapsama.toInt()} m²'
                : '${s.sinif.maxKapsama.toInt()} m² › ${s.maxKapsamaEfektif.toInt()} m²  (yükseklik düzetmesi)',
