          ),
          (
            'Tavan Yüksekliði',
            '${s.yuks.toStringAsFixed(1)} m'
                '${s.maxKapsamaEfektif < s.sinif.maxKapsama ? "  ›  kapsama düzetildi: ${s.maxKapsamaEfektif.toInt()} m² (Yükseklik etkisi)" : ""}',
          ),
          ('Tehlike Sýnýfý', '${s.sinif.kod}  —  ${s.sinif.ad}'),
