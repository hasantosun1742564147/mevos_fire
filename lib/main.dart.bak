      const SizedBox(height: 10),
      _field('Araç Sayýsý (risk bölgesi)', _aracSayisiCtrl, 'adet'),
      const SizedBox(height: 4),
      const Text(
        'VdS 3471:2023 — maks. 2 araç eþ zamanlý yanma kabul edilir',
        style: TextStyle(fontSize: 10, color: Colors.black45),
      ),
      const SizedBox(height: 10),
      _field('Uygulama Süresi', _evSureCtrl, 'dk'),
      const SizedBox(height: 4),
      const Text(
        'Binek / Hafif ticari min. 60 dk · Aðýr ticari min. 90 dk  (VdS 3471:2023)',
        style: TextStyle(fontSize: 10, color: Colors.black45),
