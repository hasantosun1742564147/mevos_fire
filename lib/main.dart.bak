                        final fc = fark > 0
                            ? const Color(0xFFDC2626)
                            : const Color(0xFF16A34A);
                        return _InfoBox(
                          color: fc.withOpacity(0.07),
                          border: fc.withOpacity(0.4),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
