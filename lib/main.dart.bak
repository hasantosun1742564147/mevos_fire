      ),
      const SizedBox(height: 14),
      _field('Araç Batarya Kapasitesi', _kapasiteCtrl, 'kWh'),
      const SizedBox(height: 4),
      const Text(
        'Tek araç batarya kapasitesi — IEC 62619 termik kaçýþ hesabýna esas',
