    'Depo (hafif)': 1000,
    'Depo (orta)': 1500,
    'Depo (aðýr)': 3000,
    'Sunucu Odasý (orta)': 2000,
    'Sunucu Odasý (yoðun)': 3500,
    'Elektrik Panosu Odasý (PVC)': 1500,
    'Elektrik Panosu Odasý (XLPE)': 1200,
    'UPS Odasý': 800,
    'Arþiv Odasý (kâðýt)': 3000,
    'Kapalý Otopark': 730,
  };

  // ¦¦ E.5 büyüme verileri
  static const Map<String, _BuyumeVeri> _e5 = {
    'Konut (ortalama)': _BuyumeVeri('Orta', 300, 250),
    'Ofis (genel)': _BuyumeVeri('Orta', 300, 250),
    'Okul / Sýnýf': _BuyumeVeri('Orta', 300, 250),
    'Otel Odasý': _BuyumeVeri('Orta', 300, 250),
    'Kütüphane (genel)': _BuyumeVeri('Hýzlý', 150, 500),
    'Alýþveriþ Merkezi': _BuyumeVeri('Hýzlý', 150, 250),
    'Sinema / Tiyatro': _BuyumeVeri('Hýzlý', 150, 500),
    'Sunucu Odasý (orta)': _BuyumeVeri('Hýzlý', 150, 500),
    'Sunucu Odasý (yoðun)': _BuyumeVeri('Hýzlý', 150, 500),
    'Elektrik Panosu Odasý (PVC)': _BuyumeVeri('Orta', 300, 250),
    'Elektrik Panosu Odasý (XLPE)': _BuyumeVeri('Orta', 300, 250),
    'Arþiv Odasý (kâðýt)': _BuyumeVeri('Hýzlý', 150, 500),
  };

  // ¦¦ NCV tablosu (EN 1991-1-2 E.3 / ISO 1716)
  static const Map<String, double> _ncv = {
    'Ahþap / Kereste': 17.5,
    'Kontrplak / MDF': 17.0,
    'Kâðýt / Karton': 20.0,
    'Tekstil (pamuklu)': 20.0,
    'Tekstil (sentetik)': 30.0,
    'Yün': 20.0,
    'Giysi': 20.0,
    'Polietilen (PE)': 40.0,
    'Polipropilen (PP)': 40.0,
    'PVC (sert)': 20.0,
    'PVC (esnek/kablo)': 22.0,
    'Polistiren (PS)': 40.0,
    'EPS köpük': 38.0,
    'XPS köpük': 38.5,
    'ABS Plastik': 35.0,
    'Poliüretan köpük (sert)': 25.0,
    'Poliüretan köpük (esnek)': 23.0,
    'Kauçuk (doðal)': 32.0,
    'Lastik (araç)': 30.0,
    'Benzin': 45.0,
    'Dizel': 45.0,
    'LPG': 46.4,
    'Metanol': 30.0,
    'Etanol': 30.0,
    'Boya / Vernik (solventli)': 30.0,
    'Asfalt / Bitüm': 40.0,
    'Elektrik Kablosu (PVC)': 22.0,
    'Elektrik Kablosu (XLPE)': 32.0,
    'Li-ion Batarya': 10.0,
    'Mobilya (karma)': 20.0,
    'Diðer (manuel)': 0.0,
  };

  bool get _isPano => _panaModu;

  void _hesapla() {
    setState(() {
      _hata = null;
      _toplamMJ = null;
      _yogunluk = null;
    });

    double alan;
    if (_panaModu) {
      final w = double.tryParse(_pWCtrl.text.replaceAll(',', '.'));
      final h = double.tryParse(_pHCtrl.text.replaceAll(',', '.'));
      final d = double.tryParse(_pDCtrl.text.replaceAll(',', '.'));
      if (w == null || h == null || d == null || w <= 0 || h <= 0 || d <= 0) {
        setState(() => _hata = 'Pano iç ölçülerini eksiksiz giriniz (cm).');
        return;
      }
      final v = (w / 100) * (h / 100) * (d / 100);
      final cableVol = v * _pDolum;
      final cableMass = cableVol * 600.0;
      final combFrac = _pKablo == 'PVC' ? 0.30 : 0.25;
      final nclvC = _pKablo == 'PVC' ? 20.0 : 32.0;
      final combCable = cableMass * combFrac;
      final compMass = v * 0.12 * 800.0;
      final combComp = compMass * 0.70;
      final totalComb = combCable + combComp;
      final energy = combCable * nclvC + combComp * 25.0;
      final eff = energy / totalComb;
      alan = (w / 100) * (d / 100);
      _alanCtrl.text = alan.toStringAsFixed(4);
      setState(() {
        _malzemeler
          ..clear()
          ..add(
            _Malzeme(
              ad: 'Elektrik Panosu (${w.round()}×${h.round()}×${d.round()} cm, $_pKablo)',
              kg: double.parse(totalComb.toStringAsFixed(2)),
              ncv: double.parse(eff.toStringAsFixed(1)),
            ),
          );
      });
    } else {
      final a = double.tryParse(_alanCtrl.text.replaceAll(',', '.'));
      if (a == null || a <= 0) {
        setState(() => _hata = 'Geçerli kat alaný giriniz (m²).');
        return;
      }
      alan = a;
      for (final m in _malzemeler) {
        if (m.kg <= 0) {
          setState(() => _hata = '"${m.ad}" kütlesi eksik.');
          return;
        }
        if (m.ncv <= 0) {
          setState(() => _hata = '"${m.ad}" ýsýl deðeri eksik.');
          return;
        }
      }
    }

    final toplam = _malzemeler.fold(0.0, (s, m) => s + m.kg * m.ncv);
    final yon = toplam / alan;
    final String sinif;
    final Color renk;
    if (yon <= 200) {
      sinif = 'Düþük Risk  (? 200 MJ/m²)';
      renk = const Color(0xFF16A34A);
    } else if (yon <= 600) {
      sinif = 'Orta Risk  (200–600 MJ/m²)';
      renk = const Color(0xFFD97706);
    } else if (yon <= 1200) {
      sinif = 'Yüksek Risk  (600–1200 MJ/m²)';
      renk = const Color(0xFFEA580C);
    } else {
      sinif = 'Çok Yüksek Risk  (> 1200 MJ/m²)';
      renk = const Color(0xFFDC2626);
    }

    double? qMax, tBuy, tSab, tToplam;
    String? e5Key;
    if (_panaModu) {
      e5Key = _pKablo == 'PVC'
          ? 'Elektrik Panosu Odasý (PVC)'
          : 'Elektrik Panosu Odasý (XLPE)';
    } else if (_secilenBina != null && _e5.containsKey(_secilenBina)) {
      e5Key = _secilenBina;
    }
    if (e5Key != null && _e5.containsKey(e5Key)) {
      final veri = _e5[e5Key]!;
      final ta = veri.tAlfa.toDouble();
      qMax = veri.rhrF * alan / 1000.0;
      tBuy = ta * math.sqrt(qMax);
      final eBuy = (1e6 / (ta * ta)) * (tBuy * tBuy * tBuy) / 3.0 / 1e6;
      final e70 = 0.70 * toplam;
      final eSab = (e70 - eBuy).clamp(0.0, double.infinity);
      tSab = tBuy + eSab * 1000.0 / (qMax * 1000.0);
      tToplam = tSab + (0.30 * toplam) * 1000.0 / (qMax * 1000.0 / 2.0);
    }

    setState(() {
      _toplamMJ = toplam;
      _yogunluk = yon;
      _riskSinifi = sinif;
      _riskRenk = renk;
      _qMax = qMax;
      _tBuyume = tBuy;
      _tSabit = tSab;
      _tToplam = tToplam;
    });

    if (_isPano) {
      if (_sAjanIdx >= 5) setState(() => _sAjanIdx = 1);
      final h = double.tryParse(_pHCtrl.text.replaceAll(',', '.'));
      if (h != null && h > 0) {
        _sYuksCtrl.text = (h / 100).toStringAsFixed(2);
        _hesaplaAjan();
      }
    }
  }

  void _hesaplaAjan() {
    setState(() {
      _sHata = null;
      _sAjanMiktar = null;
      _sSilindirSayisi = null;
    });
    final qf = _yogunluk;
    final alan = double.tryParse(_alanCtrl.text.replaceAll(',', '.'));
    final yuks = double.tryParse(_sYuksCtrl.text.replaceAll(',', '.'));
    if (qf == null) {
      setState(() => _sHata = 'Önce Yangýn Yükü hesaplayýnýz.');
      return;
    }
    if (alan == null || alan <= 0) {
      setState(() => _sHata = 'Geçerli alan giriniz.');
      return;
    }
    if (yuks == null || yuks <= 0) {
      setState(() => _sHata = 'Oda yüksekliðini giriniz (m).');
      return;
    }
    final v = alan * yuks;
    final rakimM =
        double.tryParse(_sRakimCtrl.text.replaceAll(',', '.')) ?? 0.0;
    final kf = rakimM > 0
        ? (101.325 / (101.325 * math.exp(-rakimM / 8400)))
        : 1.0;
    final ajan = _ajanlar[_sAjanIdx];
    if (ajan.ad.startsWith('ABC')) {
      final kg = v * 0.5;
      setState(() {
        _sAjanMiktar = kg;
        _sSilindirSayisi = (kg / 50).ceilToDouble();
      });
    } else {
      final s = ajan.spesifik!;
      final c =
          double.tryParse(_sKonsanCtrl.text.replaceAll(',', '.')) ??
          ajan.konsan;
      if (ajan.inert) {
        final nm3 = v * math.log(100 / (100 - c));
        setState(() {
          _sAjanMiktar = nm3;
          _sSilindirSayisi = (nm3 / 16).ceilToDouble();
        });
      } else {
        final w = (v / s) * kf * math.log(100 / (100 - c));
        setState(() {
          _sAjanMiktar = w;
          _sSilindirSayisi = (w / (ajan.ad.startsWith('CO') ? 45.0 : 100.0))
              .ceilToDouble();
        });
      }
    }
  }

  @override
  void dispose() {
    _alanCtrl.dispose();
    _pWCtrl.dispose();
    _pHCtrl.dispose();
    _pDCtrl.dispose();
    _sYuksCtrl.dispose();
    _sRakimCtrl.dispose();
    _sKonsanCtrl.dispose();
    super.dispose();
  }

